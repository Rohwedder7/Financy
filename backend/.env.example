# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# SQLite. Relative to the backend working directory.
DATABASE_URL=file:./prisma/dev.db

# Authentication. Replace locally; never commit a real secret.
JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=financy-api
JWT_AUDIENCE=financy-web
